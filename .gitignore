.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the
#   code is intended to run in multiple environments; otherwise check them in:
# .python-version

# pipenv
#   According to pypa/pipenv, we recommend adding Pipfile.lock to version
#   control.
Pipfile.lock

# poetry
#   Similar to Pipfile.lock, we generally recommend adding poetry.lock to
#   version control.
#   This is especially important for source distribution and testing.
poetry.lock

# pdm
#   Similar to Pipfile.lock, we generally recommend keeping pdm.lock in
#   version control.
pdm.lock
#   pdm stores project-wide configurations in .pdm.toml, but it is recommended
#   to not commit it.
.pdm.toml

# PEP 582; used by e.g. github.com/David-OConnor/pyflow and github.com/pypa/pipx
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

