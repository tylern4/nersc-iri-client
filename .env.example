# Copy this file to `.env` and fill in real values, or export the variables
# in your shell. The test suite reads these via pydantic-settings; the client
# itself reads IRI_API_TOKEN.

# IRI API base URL (defaults to the live deployment).
IRI_API_BASE_URL=https://api.iri.nersc.gov/api/v1

# Bearer token for authenticated (non-public) endpoints. Public read-only
# endpoints work without it. Leave blank and the tests will fall back to
# ~/.ssh/nersc-token.
IRI_ACCESS_TOKEN=

# Account used when submitting test jobs.
TEST_JOB_ACCOUNT=m0000

# Queue used when submitting test jobs.
TEST_JOB_QUEUE=debug

# Scratch directory (and subdir) used for filesystem tests.
TEST_TMP_DIR=/pscratch/sd/e/elvis/tmp/iri_client_tests

# Test username used as a filter/owner in job and filesystem tests.
TEST_USERNAME=elvis
